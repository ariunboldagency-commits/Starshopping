@@ -759,6 +759,66 @@ button.buy:disabled { opacity: 0.72; cursor: progress; }
 
 .note { margin-top: 1rem; text-align: center; font-size: 0.74rem; line-height: 1.6; color: var(--fg-dim); }
 
+/* one line of reassurance under the order button: how they pay, and whom to ring */
+.assure {
+  margin-top: 0.8rem;
+  text-align: center;
+  font-size: 0.72rem;
+  line-height: 1.55;
+  color: var(--fg-dim);
+}
+.assure a { font-weight: 700; color: var(--fg); white-space: nowrap; }
+
+/* the other way to order, for the visitor who would rather talk to someone —
+   quieter than the button, as it must not compete with it */
+.alt-order { margin-top: 0.8rem; display: flex; justify-content: center; gap: 0.6rem; }
+.alt-order__link {
+  display: inline-flex; align-items: center; gap: 0.4rem;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 0.6rem 1.1rem;
+  font-size: 0.78rem; font-weight: 700;
+  color: var(--fg);
+  transition: border-color 0.25s ease;
+}
+.alt-order__link:hover { border-color: var(--fg); }
+.alt-order__link:active { transform: scale(0.98); }
+
+/* -------- sticky order bar (phones) --------
+   Fixed to the foot of the screen while the real button is out of sight.
+   Solid, not blurred: a backdrop filter is a per-frame cost on a phone and
+   this is on screen for the whole visit. The padding respects the home
+   indicator on an iPhone so the button is never half under it. */
+.stickybuy {
+  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
+  display: flex; align-items: center; gap: 0.9rem;
+  padding: 0.7rem 1.1rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
+  background: rgba(251, 247, 240, 0.97);
+  border-top: 1px solid var(--line);
+  box-shadow: 0 -10px 30px rgba(69, 36, 26, 0.1);
+}
+.stickybuy[hidden] { display: none; }
+.stickybuy__price { display: flex; flex-direction: column; flex: 1; min-width: 0; }
+.stickybuy__total {
+  font-family: var(--font-display);
+  font-weight: 800; font-size: 1.2rem; line-height: 1.1;
+  white-space: nowrap;
+}
+.stickybuy__sub { margin-top: 0.2rem; font-size: 0.68rem; color: var(--fg-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.stickybuy__btn {
+  flex-shrink: 0;
+  background: var(--fg); color: var(--on-fg);
+  border-radius: 999px;
+  padding: 0.85rem 1.5rem;
+  font-family: var(--font-display);
+  font-weight: 800; font-size: 0.95rem; letter-spacing: 0.06em;
